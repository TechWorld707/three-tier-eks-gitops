{
  "uid": "three-tier-dev",
  "title": "Three-tier development",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "three-tier",
    "dev"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Frontend availability",
      "description": "HTTP probe of the frontend Service from inside EKS.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bool_yes_no"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "probe_success{job=\"three-tier-frontend\"}",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "title": "API traffic by route",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (route) (rate(three_tier_http_requests_total{namespace=\"three-tier-dev\",route=~\"/api/.*\"}[$__rate_interval]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "API 5xx rate",
      "description": "No ratio is shown when there is no API traffic.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "three_tier:api_5xx_ratio:rate5m",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 4,
      "title": "API p95 latency by route",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(three_tier_http_request_duration_seconds_bucket{namespace=\"three-tier-dev\",route=~\"/api/.*\"}[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Deployment replicas",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=\"three-tier-dev\"}",
          "legendFormat": "{{deployment}} available"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "kube_deployment_spec_replicas{namespace=\"three-tier-dev\"}",
          "legendFormat": "{{deployment}} desired"
        }
      ]
    },
    {
      "id": 6,
      "title": "Container restarts in 15m",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (pod, container) (increase(kube_pod_container_status_restarts_total{namespace=\"three-tier-dev\"}[15m]))",
          "legendFormat": "{{pod}} / {{container}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Database connections checked out",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(three_tier_db_pool_connections_in_use{namespace=\"three-tier-dev\"})",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 8,
      "title": "Database pool timeouts in 15m",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(three_tier_db_pool_checkout_timeouts_total{namespace=\"three-tier-dev\"}[15m]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 9,
      "title": "ALB target 5xx errors",
      "description": "Set the dashboard filters to the app ALB and frontend target group ARN suffixes.",
      "type": "timeseries",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "A",
          "region": "default",
          "namespace": "AWS/ApplicationELB",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "metricName": "HTTPCode_Target_5XX_Count",
          "statistic": "Sum",
          "matchExact": true,
          "dimensions": {
            "LoadBalancer": "$alb",
            "TargetGroup": "$target_group"
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "ALB unhealthy targets",
      "description": "Set the dashboard filters to the app ALB and frontend target group ARN suffixes.",
      "type": "timeseries",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "A",
          "region": "default",
          "namespace": "AWS/ApplicationELB",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "metricName": "UnHealthyHostCount",
          "statistic": "Maximum",
          "matchExact": true,
          "dimensions": {
            "LoadBalancer": "$alb",
            "TargetGroup": "$target_group"
          }
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "alb",
        "label": "ALB ARN suffix",
        "type": "textbox",
        "query": "*",
        "current": {
          "text": "*",
          "value": "*"
        }
      },
      {
        "name": "target_group",
        "label": "Target group ARN suffix",
        "type": "textbox",
        "query": "*",
        "current": {
          "text": "*",
          "value": "*"
        }
      }
    ]
  }
}
